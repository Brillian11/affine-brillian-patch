+
+    *,
+    *::before,
+    *::after {
+      box-sizing: border-box;
+    }
+
+    html,
+    body {
+      background: var(--td-bg);
+      color: var(--td-ink);
+      font-family: var(--td-font);
+      font-feature-settings: 'cv11', 'ss01', 'ss03';
+      -webkit-font-smoothing: antialiased;
+      -moz-osx-font-smoothing: grayscale;
+      padding: 0;
+      margin: 0;
+    }
+
+    ::selection {
+      background: var(--td-red-200);
+      color: var(--td-red-deep);
+    }
+
+    /* Subtle warm scrollbar */
+    ::-webkit-scrollbar {
+      width: 12px;
+      height: 12px;
+    }
+
+    ::-webkit-scrollbar-track {
+      background: transparent;
+    }
+
+    ::-webkit-scrollbar-thumb {
+      background: var(--td-border-strong);
+      border: 3px solid var(--td-bg);
+      border-radius: 999px;
+    }
+
+    ::-webkit-scrollbar-thumb:hover {
+      background: var(--td-ink-tertiary);
+    }
+
+    a {
+      color: var(--td-red-pressed);
+      text-decoration-color: rgba(207, 53, 32, .35);
+      text-decoration-thickness: 1px;
+      text-underline-offset: 3px;
+      transition: text-decoration-color .15s ease, color .15s ease;
+    }
+
+    a:hover {
+      color: var(--td-red-pressed);
+      text-decoration-color: var(--td-red-hover);
+    }
+
+    /* ───────── Sidebar ───────── */
+    .menu-content,
+    .menu-content>div {
+      background: var(--td-sidebar) !important;
+    }
+
+    .menu-content {
+      border-right: 1px solid var(--td-border-warm) !important;
+      box-shadow: inset -1px 0 0 var(--td-border-warm);
+    }
+
+    /* Bump the cramped 10px default — Redoc's sidebar text was unreadably small.
+       Exclude operation-type/http-verb pills, which need their own smaller font
+       (otherwise inheriting 14px clips their text inside the small pill box). */
+    .menu-content,
+    .menu-content li > label,
+    .menu-content li > a,
+    .menu-content li > label > span:not([class*="operation-type"]):not([class*="http-verb"]),
+    .menu-content li > a > span:not([class*="operation-type"]):not([class*="http-verb"]) {
+      font-size: 14px !important;
+      line-height: 1.4 !important;
+    }
+
+    .menu-content li>label,
+    .menu-content li>a {
+      border-radius: 8px !important;
+      padding-top: 8px !important;
+      padding-bottom: 8px !important;
+      padding-inline: 12px !important;
+      margin-inline: 8px !important;
+      transition:
+        background-color .15s cubic-bezier(.2, .8, .2, 1),
+        color .15s cubic-bezier(.2, .8, .2, 1);
+    }
+
+    /* padding-inline above wins over Redoc's depth-based padding-left — restore
+       the stair-step indent for nested sidebar items. */
+    .menu-content label.-depth2,
+    .menu-content a.-depth2 {
+      padding-left: 32px !important;
+      padding-right: 12px !important;
+    }
+
+    .menu-content label.-depth3,
+    .menu-content a.-depth3 {
+      padding-left: 48px !important;
+      padding-right: 12px !important;
+    }
+
+    .menu-content li>label:hover,
+    .menu-content li>a:hover {
+      background: var(--td-sidebar-hover) !important;
+      color: var(--td-ink) !important;
+    }
+
+    .menu-content label.active,
+    .menu-content .active>label,
+    .menu-content [aria-current="page"] {
+      background: var(--td-sidebar-active) !important;
+      color: var(--td-red-pressed) !important;
+      font-weight: 600 !important;
+      box-shadow: inset 0 0 0 1px rgba(207, 53, 32, .08);
+    }
+
+    /* Depth-1 group labels — make them feel like section headers */
+    .menu-content label.-depth1,
+    .menu-content a.-depth1 {
+      color: var(--td-ink) !important;
+      font-weight: 600 !important;
+      letter-spacing: -0.005em !important;
+    }
+
+    /* ───────── Logo / header / search ───────── */
+    .menu-content>div:first-child,
+    .menu-content>div:nth-child(1) {
+      border-bottom: 1px solid var(--td-border-warm) !important;
+    }
+
+    [role="search"] {
+      background: transparent !important;
+      padding: 14px 0 16px !important;
+      position: relative;
+    }
+
+    [role="search"]>div {
+      border-bottom: none !important;
+      min-height: auto !important;
+      padding: 0 !important;
+    }
+
+    [role="search"] input,
+    .search-input {
+      background: var(--td-surface) !important;
+      border: 1px solid var(--td-border-strong) !important;
+      border-radius: 10px !important;
+      box-sizing: border-box !important;
+      color: var(--td-ink) !important;
+      font-size: 14px !important;
+      font-weight: 400 !important;
+      /* Match sidebar text inset (8px margin + 12px padding) and stop before
+         the 38px chevron column used by depth-1 menu labels. */
+      margin: 0 calc(8px + 38px + 12px) 0 calc(8px + 12px) !important;
+      padding: 0 12px 0 30px !important;
+      width: calc(100% - (8px + 12px) - (8px + 38px + 12px)) !important;
+      height: 44px !important;
+      line-height: 42px !important;
+      box-shadow: 0 1px 0 rgba(31, 31, 31, .02);
+      transition: border-color .15s ease, box-shadow .15s ease;
+    }
+
+    [role="search"] input::placeholder {
+      color: var(--td-ink-tertiary) !important;
+    }
+
+    [role="search"] input:focus,
+    [role="search"] input:focus-visible {
+      border-color: var(--td-red) !important;
+      box-shadow: var(--td-shadow-focus) !important;
+      outline: none !important;
+    }
+
+    /* Icon sits in the input's left gutter; text/placeholder follows after 30px
+       padding. Anchor vertical center to the input, not the search wrapper. */
+    [role="search"]>svg {
+      left: calc(8px + 12px + 8px) !important;
+      top: calc(14px + 22px) !important;
+      transform: translateY(-50%) !important;
+      width: 14px !important;
+      height: 14px !important;
+      opacity: .55;
+      color: var(--td-ink-secondary) !important;
+    }
+
+    [role="search"] [data-role="search:clear"] {
+      right: calc(8px + 38px + 12px) !important;
+      top: calc(14px + 22px) !important;
+      transform: translateY(-50%) !important;
+    }
+
+    [data-role="search:results"] {
+      background: var(--td-sidebar) !important;
+      border-radius: 0 0 12px 12px;
+    }
+
+    [data-role="search:results"]:not(:has(*))::before {
+      content: "";
+      display: inline-block;
+      width: 20px;
+    }
+
+    [data-role="search:clear"] {
+      color: var(--td-ink-tertiary) !important;
+    }
+
+    /* ───────── Main content ───────── */
+    .redoc-wrap,
+    .api-content {
+      background: var(--td-bg) !important;
+      color: var(--td-ink) !important;
+    }
+
+    /* Let the introduction use the full content width instead of Redoc's
+       narrower column reserved for sections with code samples. */
+    .api-content > div:first-child > div:first-child {
+      background: var(--td-bg) !important;
+      display: block !important;
+      width: 100% !important;
+      max-width: none !important;
+    }
+
+    .api-info {
+      align-items: flex-start;
+      display: flex !important;
+      flex-direction: column;
+      width: 100% !important;
+      max-width: none !important;
+      margin: 0 !important;
+      padding: 48px 56px 40px !important;
+      position: relative;
+    }
+
+
+    /* Keep the inner content at a comfortable reading width despite the
+       full-width hero. */
+    .api-info > * {
+      max-width: 760px;
+    }
+
+    .api-info>* {
+      position: relative;
+      z-index: 1;
+    }
+
+    .api-info h1 {
+      color: var(--td-ink) !important;
+      font-family: var(--td-font) !important;
+      font-size: clamp(40px, 5vw, 56px) !important;
+      font-weight: 600 !important;
+      letter-spacing: -0.024em !important;
+      line-height: 1.05 !important;
+      margin: 0 0 24px !important;
+    }
+
+    /* Hide the API version number from the main title */
+    .api-info h1 span {
+      display: none !important;
+    }
+
+    @media (max-width: 780px) {
+      .api-info {
+        padding: 44px 44px 32px !important;
+      }
+    }
+
+    .api-info p,
+    .api-info li {
+      color: var(--td-ink-secondary) !important;
+      font-size: 17px !important;
+      line-height: 1.65 !important;
+      max-width: 68ch;
+    }
+
+    .api-info p:first-of-type {
+      font-size: 19px !important;
+      color: var(--td-ink) !important;
+      line-height: 1.55 !important;
+    }
+
+    /* ───────── Headings ───────── */
+    h1,
+    h2,
+    h3,
+    h4,
+    h5,
+    h6 {
+      color: var(--td-ink) !important;
+      font-family: var(--td-font) !important;
+      letter-spacing: -0.011em !important;
+    }
+
+    h2 {
+      font-size: 26px !important;
+      font-weight: 600 !important;
+      line-height: 1.2 !important;
+      margin: 0 0 16px !important;
+      letter-spacing: -0.016em !important;
+    }
+
+    /* Tag titles (e.g. "Tasks", "Projects") dominate the hierarchy —
+       they introduce a whole resource group, so they're bigger than the
+       individual operation titles. Markdown-driven groups render with a
+       "section/" prefix instead of "tag/" (e.g. "Developing with Todoist"),
+       so they get the same treatment. */
+    [data-section-id^="tag/"]:not([data-section-id*="/operation/"]) h2,
+    [data-section-id^="section/"]:not([data-section-id*="/operation/"]) h2 {
+      font-size: 38px !important;
+      letter-spacing: -0.02em !important;
+      line-height: 1.15 !important;
+      position: relative;
+      margin-bottom: 16px !important;
+    }
+
+    /* Operation titles (e.g. "Create Task") — subordinate to tag titles. */
+    [data-section-id^="operation/"] > div:nth-child(1) h2 {
+      font-size: 26px !important;
+      letter-spacing: -0.014em !important;
+      margin-bottom: 10px !important;
+    }
+
+    h3 {
+      font-size: 22px !important;
+      font-weight: 600 !important;
+      letter-spacing: -0.012em !important;
+    }
+
+    h5 {
+      color: var(--td-ink-secondary) !important;
+      font-size: 13px !important;
+      font-weight: 600 !important;
+      letter-spacing: .02em !important;
+      text-transform: uppercase !important;
+      margin-top: 0 !important;
+    }
+
+    /* Heading anchor (link) — gentler */
+    h1>a,
+    h2>a,
+    h3>a,
+    h4>a {
+      opacity: 0;
+      transition: opacity .15s ease;
+    }
+
+    h1:hover>a,
+    h2:hover>a,
+    h3:hover>a,
+    h4:hover>a,
+    h1>a:focus-visible,
+    h2>a:focus-visible,
+    h3>a:focus-visible,
+    h4>a:focus-visible {
+      opacity: .6;
+    }
+
+    /* Tag/section title rows — trim Redoc's 40px bottom pad, but keep enough
+       breathing room so titles don't crash into the content below. */
+    [data-section-id^="tag/"]:not([data-section-id*="/operation/"]) > div:first-child > div,
+    [data-section-id^="section/"] > div:first-child > div {
+      padding-top: 36px !important;
+      padding-bottom: 20px !important;
+    }
+
+    /* ───────── Body markdown ───────── */
+    .redoc-markdown p,
+    .redoc-markdown li {
+      color: var(--td-ink-secondary) !important;
+      line-height: 1.7 !important;
+    }
+
+    .redoc-markdown strong {
+      color: var(--td-ink) !important;
+      font-weight: 600 !important;
+    }
+
+    .redoc-markdown blockquote {
+      background: transparent !important;
+      border: none !important;
+      border-radius: 0 !important;
+      color: var(--td-ink) !important;
+      margin: 20px 0 8px !important;
+      padding: 0 !important;
+    }
+
+    .redoc-markdown blockquote p,
+    .redoc-markdown blockquote > :first-child {
+      margin: 0 !important;
+    }
+
+    .redoc-markdown blockquote > :not(:first-child) {
+      margin-top: 8px !important;
+    }
+
+    /* ───────── Tables ───────── */
+    .redoc-markdown table {
+      border: 1px solid var(--td-border) !important;
+      border-radius: 10px !important;
+      display: block;
+      max-width: 100%;
+      overflow-x: auto;
+      box-shadow: 0 1px 2px rgba(31, 31, 31, .02);
+    }
+
+    .redoc-markdown th {
+      background: var(--td-sidebar) !important;
+      color: var(--td-ink) !important;
+      font-weight: 600 !important;
+      font-size: 13px !important;
+      letter-spacing: .01em !important;
+    }
+
+    .redoc-markdown td,
+    .redoc-markdown th {
+      border-color: var(--td-border) !important;
+      padding: 10px 14px !important;
+    }
+
+    /* JSON tree rows in request/response samples */
+    [data-section-id^="operation/"] > div:nth-child(2) .redoc-json .hoverable {
+      transition: background-color .12s ease !important;
+    }
+
+    [data-section-id^="operation/"] > div:nth-child(2) .redoc-json .hoverable:hover {
+      background: var(--td-code-hover) !important;
+    }
+
+    [class*="property-name"] {
+      color: var(--td-ink) !important;
+      font-weight: 600 !important;
+      font-family: var(--td-mono) !important;
+      font-size: 13.5px !important;
+    }
+
+    /* Type annotations — compact labels are easier to scan than italics. */
+    .redoc-markdown table td:first-child em,
+    [class*="param-type"],
+    [class*="property-type"] {
+      background: var(--td-red-100) !important;
+      border: 1px solid var(--td-red-300) !important;
+      border-radius: 5px !important;
+      color: var(--td-red-pressed) !important;
+      display: inline-block !important;
+      font-family: var(--td-mono) !important;
+      font-size: 11px !important;
+      font-style: normal !important;
+      font-weight: 600 !important;
+      line-height: 1.4 !important;
+      padding: 2px 6px !important;
+      white-space: nowrap;
+    }
+
+    /* "Required" pills follow stable semantic nodes in Redoc's generated
+       schema markup, avoiding styled-component hashes that change by build. */
+    [class*="property-name"] + div,
+    [data-section-id^="operation/"] h5 > span + div {
+      background: var(--td-red-200) !important;
+      color: var(--td-red-deep) !important;
+      font-size: 10.5px !important;
+      font-weight: 700 !important;
+      letter-spacing: .05em !important;
+      text-transform: uppercase !important;
+      border-radius: 999px !important;
+      padding: 2px 7px !important;
+      border: none !important;
+      display: inline-block !important;
+      width: auto !important;
+      vertical-align: middle;
+      line-height: 1.4 !important;
+    }
+
+    /* ───────── Code (inline + blocks) ───────── */
+    code,
+    pre {
+      font-family: var(--td-mono) !important;
+      font-feature-settings: 'liga' 0, 'calt' 0;
+    }
+
+    code {
+      background: var(--td-red-100) !important;
+      border-radius: 5px !important;
+      border: 1px solid rgba(207, 53, 32, .08) !important;
+      color: var(--td-red-deep) !important;
+      font-size: 13px !important;
+      padding: 1px 6px !important;
+    }
+
+    pre {
+      border-radius: 10px !important;
+      box-shadow: inset 0 0 0 1px rgba(244, 236, 223, .06);
+      scrollbar-width: thin;
+      scrollbar-color: rgba(244, 236, 223, .25) transparent;
+    }
+
+    /* Themed scrollbars inside dark code blocks (Webkit). */
+    pre::-webkit-scrollbar {
+      height: 8px;
+      width: 8px;
+      background: transparent;
+    }
+
+    pre::-webkit-scrollbar-track {
+      background: transparent;
+      margin: 0 8px;
+    }
+
+    pre::-webkit-scrollbar-thumb {
+      background: rgba(244, 236, 223, .18);
+      border-radius: 999px;
+      transition: background .15s ease;
+    }
+
+    pre::-webkit-scrollbar-thumb:hover {
+      background: rgba(244, 236, 223, .35);
+    }
+
+    pre::-webkit-scrollbar-corner {
+      background: transparent;
+    }
+
+    /* Light-area code blocks (e.g. markdown body) use warm cream scrollbars */
+    .redoc-markdown pre {
+      scrollbar-color: var(--td-border-strong) transparent;
+    }
+
+    .redoc-markdown pre::-webkit-scrollbar-thumb {
+      background: var(--td-border-strong);
+    }
+
+    .redoc-markdown pre::-webkit-scrollbar-thumb:hover {
+      background: var(--td-ink-tertiary);
+    }
+
+    pre code {
+      background: transparent !important;
+      border: none !important;
+      color: inherit !important;
+      padding: 0 !important;
+    }
+
+    /* ───────── HTTP method badges ───────── */
+    [class*="http-verb"],
+    [class*="operation-type"],
+    .operation-type {
+      font-family: var(--td-font) !important;
+      font-weight: 700 !important;
+      font-size: 10.5px !important;
+      letter-spacing: .08em !important;
+      text-transform: uppercase !important;
+      border-radius: 5px !important;
+      padding: 3px 7px !important;
+      min-width: 48px !important;
+      text-align: center !important;
+      line-height: 1.3 !important;
+      color: #ffffff !important;
+      text-shadow: 0 1px 0 rgba(0, 0, 0, .12);
+    }
+
+    /* Sidebar pills are tiny inline chips next to each operation name.
+       Override the larger main-content pill rules: smaller font, no min-width,
+       no fixed height (Redoc's default constrains height and clips text). */
+    .menu-content [class*="operation-type"],
+    .menu-content [class*="http-verb"] {
+      flex-shrink: 0;
+      margin-right: 10px;
+      font-size: 9.5px !important;
+      letter-spacing: .06em !important;
+      padding: 3px 6px !important;
+      min-width: 0 !important;
+      height: auto !important;
+      line-height: 1.4 !important;
+      border-radius: 4px !important;
+      align-self: center;
+    }
+
+    [class*="http-verb"].get,
+    [class*="operation-type"].get {
+      background: var(--td-get) !important;
+      color: #ffffff !important;
+    }
+
+    [class*="http-verb"].post,
+    [class*="operation-type"].post {
+      background: var(--td-post) !important;
+      color: #ffffff !important;
+    }
+
+    [class*="http-verb"].put,
+    [class*="operation-type"].put {
+      background: var(--td-put) !important;
+      color: #ffffff !important;
+    }
+
+    [class*="http-verb"].patch,
+    [class*="operation-type"].patch {
+      background: var(--td-patch) !important;
+      color: #ffffff !important;
+    }
+
+    [class*="http-verb"].delete,
+    [class*="operation-type"].delete {
+      background: var(--td-delete) !important;
+      color: #ffffff !important;
+    }
+
+    [class*="http-verb"].options,
+    [class*="operation-type"].options {
+      background: var(--td-options) !important;
+      color: #ffffff !important;
+    }
+
+    [class*="http-verb"].head,
+    [class*="operation-type"].head {
+      background: var(--td-head) !important;
+      color: #ffffff !important;
+    }
+
+    /* ───────── Tabs ───────── */
+    .react-tabs__tab-list {
+      border-bottom: 1px solid var(--td-code-border) !important;
+      margin: 0 0 14px !important;
+      padding: 0 !important;
+    }
+
+    .react-tabs__tab {
+      border-radius: 8px 8px 0 0 !important;
+      font-family: var(--td-font) !important;
+      font-size: 12px !important;
+      font-weight: 600 !important;
+      letter-spacing: .04em !important;
+      text-transform: uppercase !important;
+      padding: 8px 14px !important;
+      min-height: 44px;
+      color: var(--td-code-muted) !important;
+      border: none !important;
+      transition: color .15s ease, background .15s ease;
+    }
+
+    .react-tabs__tab:hover {
+      color: var(--td-code-text) !important;
+    }
+
+    .react-tabs__tab--selected {
+      color: var(--td-code-text) !important;
+      background: rgba(244, 236, 223, .06) !important;
+      position: relative;
+    }
+
+    .react-tabs__tab--selected::after {
+      content: "";
+      position: absolute;
+      left: 14px;
+      right: 14px;
+      bottom: -1px;
+      height: 2px;
+      background: var(--td-red);
+      border-radius: 2px;
+    }
+
+    /* Tabs in the light documentation column. */
+    [data-section-id^="operation/"] > div:first-child .react-tabs__tab {
+      color: var(--td-ink-tertiary) !important;
+    }
+
+    [data-section-id^="operation/"] > div:first-child .react-tabs__tab--selected {
+      background: var(--td-sidebar) !important;
+      color: var(--td-ink) !important;
+    }
+
+    /* ───────── Buttons (Copy / Expand all / etc) ───────── */
+    button {
+      font-family: var(--td-font) !important;
+      border-radius: 8px;
+    }
+
+    /* ───────── Right (dark) code-samples panel ─────────
+       Redoc renders each operation as:
+         [data-section-id^="operation/"]
+           > div  (left/middle: docs)
+           > div  (right: dark code samples panel)
+       Lock dark styling to that second sibling — don't rely on Redoc's
+       styled-component class hashes, which change every build. */
+    [data-section-id^="operation/"] > div:nth-child(2) {
+      position: relative;
+      background-color: var(--td-code-bg) !important;
+      color: var(--td-code-text) !important;
+    }
+
+    [data-section-id^="operation/"] > div:nth-child(2)::before {
+      content: "";
+      position: absolute;
+      inset: 0 0 auto 0;
+      height: 120px;
+      background: radial-gradient(ellipse 60% 100% at 50% 0%, rgba(227, 68, 50, .10), transparent 75%);
+      pointer-events: none;
+      z-index: 0;
+    }
+
+    [data-section-id^="operation/"] > div:nth-child(2) > * {
