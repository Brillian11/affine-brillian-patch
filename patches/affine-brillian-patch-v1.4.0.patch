+/* ===== TASK CARD ===== */
+.task-card {
+  display: flex;
+  justify-content: space-between;
+  align-items: flex-start;
+  padding: 12px 16px;
+  margin: 4px 0;
+  background: var(--affine-background-primary-color, #ffffff);
