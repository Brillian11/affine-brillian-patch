+          const model = store.getModelById(newBlockId);
+          if (model?.text) {
+            model.text.insert(`[todoist:${taskId}]`, 0);
+          }
+        } catch (textErr) {
+          console.warn('[DocTodoistIntegration] Could not set block text:', textErr);
+        }
+      }
+    } catch (err) {
