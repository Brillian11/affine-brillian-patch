+// Fetch actual full-text content of a document from Paperless REST API by document ID
+async function fetchDocumentDetails(docId: number | string): Promise<{ title: string; content?: string; created?: string }> {
+  const endpoints = [
+    `${PAPERLESS_REST_PRIMARY}/api/documents/${docId}/`,
+    `${PAPERLESS_BASE_URL}/api/documents/${docId}/`,
+  ];
+  for (const ep of endpoints) {
+    try {
+      const res = await fetch(ep, {
+        headers: { Authorization: `Token ${PAPERLESS_TOKEN}` },
+      });
+      if (res.ok) {
+        const data = await res.json();
+        return {
+          title: data.title || `Document #${docId}`,
+          content: data.content,
+          created: data.created,
+        };
+      }
+    } catch {
+      // try next
+    }
+  }
+  return { title: `Document #${docId}` };
+}
